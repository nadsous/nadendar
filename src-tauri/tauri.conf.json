{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nadendar",
  "version": "0.1.0",
  "identifier": "site.nads.nadendar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nadendar",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#111113",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://data.education.gouv.fr"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Le calendrier de nads",
    "longDescription": "Calendrier familial à plugins : personas, plannings de travail, scolaire, météo, lune et soleil, Gantt, budget, courses, livraisons.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "section": "utils" }
    }
  }
}
